generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COORDINATOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ClubCategory {
  TECHNICAL
  CULTURAL
  SPORTS
  SOCIAL
  ACADEMIC
  ENTREPRENEURSHIP
  OTHER
}

enum ClubStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum ClubMemberRole {
  MEMBER
  CORE_MEMBER
  COORDINATOR
  SECRETARY
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum RecruitmentStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  SHORTLISTED
  SELECTED
  REJECTED
}

enum EventCategory {
  WORKSHOP
  SEMINAR
  COMPETITION
  CULTURAL_FEST
  SPORTS
  HACKATHON
  SOCIAL_CAUSE
  MEETUP
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
  WAITLISTED
}

enum VolunteerOppStatus {
  OPEN
  FILLED
  CLOSED
}

enum VolunteerAppStatus {
  PENDING
  ACCEPTED
  REJECTED
  BACKUP
}

enum VolunteerAssignStatus {
  ASSIGNED
  REPLACEMENT_REQUESTED
  REPLACED
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  VERIFIED
}

enum AnnouncementTarget {
  ALL
  MEMBERS
  VOLUNTEERS
}

enum NotificationType {
  EVENT_NEW
  EVENT_UPDATE
  REGISTRATION_CONFIRMED
  REGISTRATION_CANCELLED
  EVENT_REMINDER
  VOLUNTEER_OPEN
  VOLUNTEER_STATUS
  TASK_ASSIGNED
  TASK_REMINDER
  TASK_STATUS
  ANNOUNCEMENT
  RECRUITMENT_STATUS
  VOLUNTEER_REPLACEMENT
}

enum AttendanceMethod {
  QR_SCAN
  MANUAL
}

enum ContributionCategory {
  VOLUNTEER_WORK
  TASK_COMPLETION
  COORDINATION
  OTHER
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  passwordHash     String
  name             String
  rollNumber       String       @unique
  department       String
  year             Int          @default(1)
  phone            String?
  avatarUrl        String?
  role             UserRole     @default(STUDENT)
  status           UserStatus   @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relationships
  coordinatedClubs       Club[]                  @relation("StudentCoordinator")
  clubMemberships        ClubMembership[]
  recruitmentApplications RecruitmentApplication[]
  createdEvents          Event[]                 @relation("EventCreator")
  eventRegistrations     EventRegistration[]
  volunteerApplications  VolunteerApplication[]
  volunteerAssignments   VolunteerAssignment[]   @relation("AssignedVolunteer")
  backupAssignments      VolunteerAssignment[]   @relation("BackupVolunteer")
  assignedTasks          Task[]                  @relation("TaskAssignee")
  verifiedTasks          Task[]                  @relation("TaskVerifier")
  taskComments           TaskComment[]
  announcements          Announcement[]
  notifications          Notification[]
  attendances            Attendance[]            @relation("Attendee")
  markedAttendances      Attendance[]            @relation("AttendanceMarker")
  contributions          Contribution[]          @relation("UserContributions")
  verifiedContributions  Contribution[]          @relation("ContributionVerifier")
  notificationPreference NotificationPreference?

  @@index([email])
  @@index([role])
}

model Club {
  id                   String            @id @default(cuid())
  name                 String            @unique
  slug                 String            @unique
  description          String
  category             ClubCategory      @default(TECHNICAL)
  logoUrl              String?
  bannerUrl            String?
  facultyCoordinator   String
  studentCoordinatorId String?
  studentCoordinator   User?             @relation("StudentCoordinator", fields: [studentCoordinatorId], references: [id])
  contactEmail         String
  contactPhone         String?
  status               ClubStatus        @default(PENDING_APPROVAL)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  members              ClubMembership[]
  recruitmentDrives    RecruitmentDrive[]
  events               Event[]
  announcements        Announcement[]
  contributions        Contribution[]

  @@index([category])
  @@index([status])
}

model ClubMembership {
  id        String           @id @default(cuid())
  clubId    String
  club      Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ClubMemberRole   @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
}

model RecruitmentDrive {
  id           String                   @id @default(cuid())
  clubId       String
  club         Club                     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title        String
  description  String
  requirements String
  deadline     DateTime
  status       RecruitmentStatus        @default(OPEN)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  applications RecruitmentApplication[]

  @@index([clubId])
  @@index([status])
}

model RecruitmentApplication {
  id                 String            @id @default(cuid())
  driveId            String
  drive              RecruitmentDrive  @relation(fields: [driveId], references: [id], onDelete: Cascade)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  statementOfPurpose String
  experience         String?
  portfolioUrl       String?
  status             ApplicationStatus @default(PENDING)
  reviewNotes        String?
  appliedAt          DateTime          @default(now())
  reviewedAt         DateTime?

  @@unique([driveId, userId])
  @@index([driveId])
  @@index([userId])
  @@index([status])
}

model Event {
  id                    String                 @id @default(cuid())
  clubId                String
  club                  Club                   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdById           String
  createdBy             User                   @relation("EventCreator", fields: [createdById], references: [id])
  title                 String
  slug                  String                 @unique
  description           String
  bannerUrl             String?
  category              EventCategory          @default(WORKSHOP)
  venue                 String
  startDateTime         DateTime
  endDateTime           DateTime
  registrationStartDate DateTime
  registrationEndDate   DateTime
  maxCapacity           Int
  registeredCount       Int                    @default(0)
  status                EventStatus            @default(DRAFT)
  requiresApproval      Boolean                @default(false)
  checkInSecret         String                 @unique @default(cuid())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  registrations          EventRegistration[]
  volunteerOpportunities VolunteerOpportunity[]
  volunteerAssignments   VolunteerAssignment[]
  tasks                  Task[]
  announcements          Announcement[]
  attendances            Attendance[]
  contributions          Contribution[]

  @@index([clubId])
  @@index([startDateTime])
  @@index([status])
}

model EventRegistration {
  id           String             @id @default(cuid())
  eventId      String
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketCode   String             @unique
  status       RegistrationStatus @default(REGISTERED)
  registeredAt DateTime           @default(now())
  cancelledAt  DateTime?

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model VolunteerOpportunity {
  id               String                 @id @default(cuid())
  eventId          String
  event            Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roleTitle        String
  description      String
  skillsRequired   String?
  volunteersNeeded Int
  status           VolunteerOppStatus     @default(OPEN)
  createdAt        DateTime               @default(now())

  applications     VolunteerApplication[]
  assignments      VolunteerAssignment[]

  @@index([eventId])
}

model VolunteerApplication {
  id            String               @id @default(cuid())
  opportunityId String
  opportunity   VolunteerOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  note          String?
  status        VolunteerAppStatus   @default(PENDING)
  appliedAt     DateTime             @default(now())
  reviewedAt    DateTime?

  @@unique([opportunityId, userId])
  @@index([opportunityId])
  @@index([userId])
}

model VolunteerAssignment {
  id             String                @id @default(cuid())
  opportunityId  String
  opportunity    VolunteerOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User                  @relation("AssignedVolunteer", fields: [userId], references: [id], onDelete: Cascade)
  roleName       String
  reportingTime  DateTime
  reportingVenue String
  status         VolunteerAssignStatus @default(ASSIGNED)
  backupUserId   String?
  backupUser     User?                 @relation("BackupVolunteer", fields: [backupUserId], references: [id])
  notes          String?
  assignedAt     DateTime              @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Task {
  id               String        @id @default(cuid())
  eventId          String
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedToUserId String
  assignedToUser   User          @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: Cascade)
  title            String
  description      String
  priority         TaskPriority  @default(MEDIUM)
  deadline         DateTime
  status           TaskStatus    @default(PENDING)
  verifiedById     String?
  verifiedByUser   User?         @relation("TaskVerifier", fields: [verifiedById], references: [id])
  verifiedAt       DateTime?
  pointsValue      Int           @default(5)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  comments         TaskComment[]

  @@index([eventId])
  @@index([assignedToUserId])
  @@index([status])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Announcement {
  id         String             @id @default(cuid())
  clubId     String?
  club       Club?              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  eventId    String?
  event      Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId   String
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  content    String
  targetRole AnnouncementTarget @default(ALL)
  isPinned   Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([clubId])
  @@index([eventId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  linkUrl   String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model Attendance {
  id          String           @id @default(cuid())
  eventId     String
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation("Attendee", fields: [userId], references: [id], onDelete: Cascade)
  markedById  String
  markedByUser User            @relation("AttendanceMarker", fields: [markedById], references: [id])
  checkInTime DateTime         @default(now())
  method      AttendanceMethod @default(QR_SCAN)
  createdAt   DateTime         @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Contribution {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation("UserContributions", fields: [userId], references: [id], onDelete: Cascade)
  clubId       String?
  club         Club?                @relation(fields: [clubId], references: [id], onDelete: SetNull)
  eventId      String?
  event        Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  points       Int
  reason       String
  category     ContributionCategory @default(VOLUNTEER_WORK)
  verifiedById String
  verifier     User                 @relation("ContributionVerifier", fields: [verifiedById], references: [id])
  createdAt    DateTime             @default(now())

  @@index([userId])
  @@index([clubId])
  @@index([createdAt])
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEventReminders Boolean  @default(true)
  emailTaskUpdates    Boolean  @default(true)
  emailRecruitment    Boolean  @default(true)
  inAppAnnouncements  Boolean  @default(true)
  inAppTasks          Boolean  @default(true)
  inAppEvents         Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}
